{
  "name": "demo-platform",
  "private": true,
  "type": "module",
  "description": "Demo platform: one public HTTP API over mock provider systems, built per specs 00 to 03.",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint --max-warnings 0 .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:prose": "tsx tree-checks/bin/check-prose.ts",
    "check:pure-imports": "tsx tree-checks/bin/check-pure-imports.ts",
    "check:single-definition": "tsx tree-checks/bin/check-single-definition.ts",
    "synth": "npm run synth --workspace infra",
    "smoke:local": "tsx infra/bin/smoke-local.ts",
    "demo:local": "tsx services/local-demo/bin/start-local-demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "24.19.2",
    "aws-cdk": "2.1145.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
