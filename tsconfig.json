{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "services/*/src",
    "services/*/bin",
    "services/*/test",
    "infra/bin",
    "infra/lib",
    "infra/test",
    "tree-checks/src",
    "tree-checks/bin",
    "tree-checks/test",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
